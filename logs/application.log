from models import DocumentDetector
from utils import get_logger

from .enhance import scan_effect
from .geometry import four_point_transform, polygon_to_quad

log = get_logger(__name__)


class DocumentScanner:
    def __init__(self, detector: DocumentDetector, enhance: bool = True):
        self.detector, self.enhance = detector, enhance

    def scan(self, image: np.ndarray) -> np.ndarray | None:
        polygon = self.detector.detect(image)
        if polygon is None:
            return None
        quad = polygon_to_quad(polygon)
        warped = four_point_transform(image, quad)
        return scan_effect(warped) if self.enhance else warped
