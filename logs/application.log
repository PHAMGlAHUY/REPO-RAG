10, 160]])\n    assert out.shape[:2] == (149, 199) or abs(out.shape[0] - 150) <= 1', 'metadata': {'file_path': 'tests/test_geometry.py', 'directory_path': 'tests', 'chunk_type': 'function', 'node_name': 'test_warp_shape', 'parent_class': '', 'start_line': 13, 'end_line': 16, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '1b260d1e-9209-5082-834e-525681f63bfd', 'content': '# File: tests/test_geometry.py\n# Node: test_yolo_label\ndef test_yolo_label():\n    line = polygon_to_yolo_seg([(0, 0), (50, 0), (50, 100), (0, 100)], 100, 100)\n    assert line.startswith("0 0.000000 0.000000 0.500000")', 'metadata': {'file_path': 'tests/test_geometry.py', 'directory_path': 'tests', 'chunk_type': 'function', 'node_name': 'test_yolo_label', 'parent_class': '', 'start_line': 19, 'end_line': 21, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'f5e28d10-512c-5c90-818e-7a41bd9424bf', 'content': '# File: tests/test_geometry.py\n# Node: test_parse_corners_normalized_and_pixel\ndef test_parse_corners_normalized_and_pixel():\n    from dataset import parse_corners\n    norm = parse_corners([0.1, 0.1, 0.9, 0.1, 0.9, 0.9, 0.1, 0.9], 200, 100)\n    assert norm.tolist()[0] == [20.0, 10.0]\n    pix = parse_corners([[10, 10], [190, 10], [190, 90], [10, 90]], 200, 100)\n    assert pix.tolist()[2] == [190.0, 90.0]', 'metadata': {'file_path': 'tests/test_geometry.py', 'directory_path': 'tests', 'chunk_type': 'function', 'node_name': 'test_parse_corners_normalized_and_pixel', 'parent_class': '', 'start_line': 24, 'end_line': 29, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '98d1c76f-bc65-5c37-ba2e-7a4c5309c335', 'content': '# File: tests/test_geometry.py\n# Node: test_geometry\nimport numpy as np\n\nfrom dataset import polygon_to_yolo_seg\nfrom processing import four_point_transform, order_points', 'metadata': {'file_path': 'tests/test_geometry.py', 'directory_path'