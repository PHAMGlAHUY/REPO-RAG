[2026-11-17 15:57:45] INFO - ingestion -  [33m decode: """Chuyển nhãn sang định dạng YOLO-seg: `class x1 y1 x2 y2 ...` (toạ độ chuẩn hoá 0-1)."""
import json
from pathlib import Path


def polygon_to_yolo_seg(points, width: int, height: int, class_id: int = 0) -> str:
    coords = []
    for x, y in points:
        coords += [f"{min(max(x / width, 0), 1):.6f}", f"{min(max(y / height, 0), 1):.6f}"]
    return f"{class_id} " + " ".join(coords)


def labelme_to_yolo_seg(json_path: Path | str, class_names: list[str]) -> list[str]:
    data = json.loads(Path(json_path).read_text(encoding="utf-8"))
    w, h = data["imageWidth"], data["imageHeight"]
    lines = []
    for shape in data["shapes"]:
        if shape["label"] in class_names and shape.get("shape_type", "polygon") == "polygon":
            cid = class_names.index(shape["label"])
            lines.append(polygon_to_yolo_seg(shape["points"], w, h, cid))
    return lines
