from dataset import polygon_to_yolo_seg
from processing import four_point_transform, order_points


def test_order_points():
    pts = [[100, 100], [0, 100], [0, 0], [100, 0]]
    out = order_points(pts)
    assert out.tolist() == [[0, 0], [100, 0], [100, 100], [0, 100]]


def test_warp_shape():
    img = np.zeros((200, 300, 3), dtype=np.uint8)
    out = four_point_transform(img, [[10, 10], [210, 10], [210, 160], [10, 160]])
    assert out.shape[:2] == (149, 199) or abs(out.shape[0] - 150) <= 1


def test_yolo_label():
    line = polygon_to_yolo_seg([(0, 0), (50, 0), (50, 100), (0, 100)], 100, 100)
    assert line.startswith("0 0.000000 0.000000 0.500000")


def test_parse_corners_normalized_and_pixel():
    from dataset import parse_corners
    norm = parse_corners([0.1, 0.1, 0.9, 0.1, 0.9, 0.9, 0.1, 0.9], 200, 100)
    assert norm.tolist()[0] == [20.0, 10.0]
    pix = parse_corners([[10, 10], [190, 10], [190, 90], [10, 90]], 200, 100)
    assert pix.tolist()[2] == [190.0, 90.0]
