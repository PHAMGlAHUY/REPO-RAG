[2026-11-17 15:57:45] INFO - ingestion -  [33m decode: from pathlib import Path

import cv2
import numpy as np


def list_images(folder: Path | str, extensions: list[str]) -> list[Path]:
    folder = Path(folder)
    return sorted(p for p in folder.iterdir() if p.suffix.lower() in extensions)


def read_image(path: Path | str) -> np.ndarray:
    img = cv2.imread(str(path))
    if img is None:
        raise FileNotFoundError(f"Không đọc được ảnh: {path}")
    return img


def save_image(path: Path | str, image: np.ndarray) -> None:
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    cv2.imwrite(str(path), image)
