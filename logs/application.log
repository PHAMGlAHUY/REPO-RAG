[2026-11-17 15:57:45] INFO - ingestion -  [33m decode: """Đọc settings.yaml và khởi tạo logging từ logging.yaml."""
import logging.config
from pathlib import Path

import yaml

PROJECT_ROOT = Path(__file__).resolve().parents[1]
CONFIG_DIR = PROJECT_ROOT / "config"


def load_settings(path: Path | str = CONFIG_DIR / "settings.yaml") -> dict:
    with open(path, encoding="utf-8") as f:
        return yaml.safe_load(f)


def setup_logging(path: Path | str = CONFIG_DIR / "logging.yaml") -> None:
    with open(path, encoding="utf-8") as f:
        cfg = yaml.safe_load(f)
    for handler in cfg.get("handlers", {}).values():
        if "filename" in handler:
            log_file = PROJECT_ROOT / handler["filename"]
            log_file.parent.mkdir(parents=True, exist_ok=True)
            handler["filename"] = str(log_file)
    logging.config.dictConfig(cfg)


def resolve(rel_path: str) -> Path:
    """Chuyển đường dẫn tương đối trong settings thành tuyệt đối."""
    return PROJECT_ROOT / rel_path
