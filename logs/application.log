from ultralytics import YOLO

from utils import get_logger

log = get_logger(__name__)


class DocumentDetector:
    """Bọc YOLO-seg: trả về đa giác (N,2) của tài liệu, toạ độ theo ảnh gốc."""

    def __init__(self, weights: str, conf=0.5, iou=0.7, imgsz=640, device=0):
        self.model = YOLO(weights)
        self.kw = dict(conf=conf, iou=iou, imgsz=imgsz, device=device, verbose=False)

    def detect(self, image: np.ndarray) -> np.ndarray | None:
        res = self.model.predict(image, **self.kw)[0]
        if res.masks is None or len(res.masks) == 0:
            log.warning("Không phát hiện tài liệu")
            return None
        best = int(res.boxes.conf.argmax())
        return res.masks.xy[best]
