[2026-11-17 15:58:55] INFO - ingestion -  [33m decode: import cv2
import numpy as np


def order_points(pts) -> np.ndarray:
    """Sắp xếp 4 điểm: trên-trái, trên-phải, dưới-phải, dưới-trái."""
    pts = np.asarray(pts, dtype="float32").reshape(4, 2)
    s, d = pts.sum(axis=1), np.diff(pts, axis=1).ravel()
    return np.array([pts[np.argmin(s)], pts[np.argmin(d)],
                     pts[np.argmax(s)], pts[np.argmax(d)]], dtype="float32")


def polygon_to_quad(polygon) -> np.ndarray:
    """Xấp xỉ đa giác mask thành tứ giác 4 góc."""
    hull = cv2.convexHull(np.asarray(polygon, dtype="float32"))
    peri = cv2.arcLength(hull, True)
    for eps in np.linspace(0.01, 0.1, 10):
        approx = cv2.approxPolyDP(hull, eps * peri, True)
        if len(approx) == 4:
            return order_points(approx)
    return order_points(cv2.boxPoints(cv2.minAreaRect(hull)))


def four_point_transform(image: np.ndarray, quad) -> np.ndarray:
    tl, tr, br, bl = order_points(quad)
    w = int(max(np.linalg.norm(br - bl), np.linalg.norm(tr - tl)))
    h = int(max(np.linalg.norm(tr - br), np.linalg.norm(tl - bl)))
    dst = np.array([[0, 0], [w - 1, 0], [w - 1, h - 1], [0, h - 1]], dtype="float32")
    M = cv2.getPerspectiveTransform(np.array([tl, tr, br, bl], dtype="float32"), dst)
    return cv2.warpPerspective(image, M, (w, h))
