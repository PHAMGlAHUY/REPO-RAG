er.py\n# Node: splitter\n"""Chia ảnh + nhãn thành train/val/test theo cấu trúc YOLO và sinh dataset.yaml."""\nimport random\nimport shutil\nfrom pathlib import Path\n\nimport yaml\n\nfrom utils import get_logger, list_images\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'dataset/splitter.py', 'directory_path': 'dataset', 'chunk_type': 'module_header', 'node_name': 'splitter', 'parent_class': '', 'start_line': 1, 'end_line': 10, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}] [0m
