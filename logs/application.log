 config/loader.py\n# Node: resolve\ndef resolve(rel_path: str) -> Path:\n    """Chuyển đường dẫn tương đối trong settings thành tuyệt đối."""\n    return PROJECT_ROOT / rel_path', 'metadata': {'file_path': 'config/loader.py', 'directory_path': 'config', 'chunk_type': 'function', 'node_name': 'resolve', 'parent_class': '', 'start_line': 27, 'end_line': 29, 'language': 'py', 'docstring': 'Chuyển đường dẫn tương đối trong settings thành tuyệt đối.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '339b99bc-c3d4-5fbd-bebb-27c285f4f01d', 'content': '# File: config/loader.py\n# Node: loader\n"""Đọc settings.yaml và khởi tạo logging từ logging.yaml."""\nimport logging.config\nfrom pathlib import Path\n\nimport yaml\n\nPROJECT_ROOT = Path(__file__).resolve().parents[1]\nCONFIG_DIR = PROJECT_ROOT / "config"', 'metadata': {'file_path': 'config/loader.py', 'directory_path': 'config', 'chunk_type': 'module_header', 'node_name': 'loader', 'parent_class': '', 'start_line': 1, 'end_line': 8, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '79d0cd34-b693-5168-a3cb-c0c283ceb00d', 'content': '# File: dataset/__init__.py\n# Node: __init__\nfrom .converter import labelme_to_yolo_seg, polygon_to_yolo_seg\nfrom .hf_loader import download_from_hf, inspect_hf_dataset, parse_corners\nfrom .splitter import split_dataset\n\n__all__ = ["download_from_hf", "inspect_hf_dataset", "labelme_to_yolo_seg",\n           "parse_corners", "polygon_to_yolo_seg", "split_dataset"]\n', 'metadata': {'file_path': 'dataset/__init__.py', 'directory_path': 'dataset', 'chunk_type': 'entire_file', 'node_name': '__init__', 'parent_class': '', 'start_line': 1, 'end_line': 6, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'bf861e72-e203-5490-bbcf-5e3db8fc844a', 'content': '# File: dataset/converter.py\n# Node: polygon_to_yolo_seg\ndef polygon_to_yolo_seg(points, width: int, height: int, class_id: int = 0) -> str:\n    coords = []\n    for x, y in points:\n        coords += [f"{min(max(x / width, 0), 1):.6f}", f"{min(max(y / height, 0), 1):.6f}"]\n    return f"{class_id} " + " ".join(coords)', 'metadata': {'file_path': 'dataset/converter.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'polygon_to_yolo_seg', 'parent_class': '', 'start_line': 6, 'end_line': 10, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '48b9e77b-c978-57e0-9fd0-9a2bd91a304e', 'content': '# File: dataset/converter.py\n# Node: labelme_to_yolo_seg\ndef labelme_to_yolo_seg(json_path: Path | str, class_names: list[str]) -> list[str]:\n    data = json.loads(Path(json_path).read_text(encoding="utf-8"))\n    w, h = data["imageWidth"], data["imageHeight"]\n    lines = []\n    for shape in data["shapes"]:\n        if shape["label"] in class_names and shape.get("shape_type", "polygon") == "polygon":\n            cid = class_names.index(shape["label"])\n            lines.append(polygon_to_yolo_seg(shape["points"], w, h, cid))\n    return lines', 'metadata': {'file_path': 'dataset/converter.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'labelme_to_yolo_seg', 'parent_class': '', 'start_line': 13, 'end_line': 21, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '69583c56-81f0-5f4a-8698-c6005a82f968', 'content': '# File: dataset/converter.py\n# Node: converter\n"""Chuyển nhãn sang định dạng YOLO-seg: `class x1 y1 x2 y2 ...` (toạ độ chuẩn hoá 0-1)."""\nimport json\nfrom pathlib import Path', 'metadata': {'file_path': 'dataset/converter.py', 'directory_path': 'dataset', 'chunk_type': 'module_header', 'node_name': 'converter', 'parent_class': '', 'start_line': 1, 'end_line': 3, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'eb00c6ef-d286-5b6c-94ae-9a8ae3a31e85', 'content': '# File: dataset/hf_loader.py\n# Node: parse_corners\ndef parse_corners(raw, width: int, height: int, normalized="auto") -> np.ndarray | None:\n    """Chuyển nhiều dạng góc ([[x,y]*4] hoặc phẳng 8 số) thành mảng pixel (N,2)."""\n    try:\n        pts = np.asarray(raw, dtype="float64").reshape(-1, 2)\n    except (ValueError, TypeError):\n        return None\n    if len(pts) < 3:\n        return None\n    if normalized == "auto":\n        normalized = pts.max() <= 1.5\n    if normalized:\n        pts = pts * np.array([width, height])\n    return pts', 'metadata': {'file_path': 'dataset/hf_loader.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'parse_corners', 'parent_class': '', 'start_line': 13, 'end_line': 25, 'language': 'py', 'docstring': 'Chuyển nhiều dạng góc ([[x,y]*4] hoặc phẳng 8 số) thành mảng pixel (N,2).', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '786093e7-02fc-5230-a727-082a6498e493', 'content': '# File: dataset/hf_loader.py\n# Node: inspect_hf_dataset\ndef inspect_hf_dataset(repo_id: str, split: str = "train") -> dict:\n    """In tên cột + 1 mẫu để biết cấu trúc dữ liệu."""\n    from datasets import load_dataset\n\n    ds = load_dataset(repo_id, split=split, streaming=True)\n    sample = next(iter(ds))\n    for key, value in sample.items():\n        shown = f"PIL {value.size}" if hasattr(value, "size") and hasattr(value, "convert") else repr(value)[:120]\n        log.info("Cột %-15s = %s", key, shown)\n    return sample', 'metadata': {'file_path': 'dataset/hf_loader.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'inspect_hf_dataset', 'parent_class': '', 'start_line': 28, 'end_line': 37, 'language': 'py', 'docstring': 'In tên cột + 1 mẫu để biết cấu trúc dữ liệu.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '34a7aa00-ebdd-500b-a61f-4f0c040479ad', 'content': '# File: dataset/hf_loader.py\n# Node: download_from_hf\ndef download_from_hf(repo_id, split, max_samples, image_column, corners_column,\n                     normalized, out_images, out_labels, streaming=True,\n                     negative_column=None, keep_negatives=True) -> int:\n    from datasets import load_dataset\n\n    out_images, out_labels = Path(out_images), Path(out_labels)\n    out_images.mkdir(parents=True, exist_ok=True)\n    out_labels.mkdir(parents=True, exist_ok=True)\n\n    ds = load_dataset(repo_id, split=split, streaming=streaming)\n    saved = skipped = 0\n    for row in ds:\n        if saved >= max_samples:\n            break\n        img = row[image_column].convert("RGB")\n        w, h = img.size\n\n        if negative_column and row.get(negative_column):\n            if not keep_negatives:\n                skipped += 1\n                continue\n            label = ""                       # ảnh không có tài liệu -> nhãn rỗng\n        else:\n            if isinstance(corners_column, list):\n                raw = [row[c] for c in corners_column]\n            else:\n                raw = row[corners_column]\n            pts = parse_corners(raw, w, h, normalized)\n            if pts is None:\n                skipped += 1\n                continue\n            label = polygon_to_yolo_seg(pts, w, h)\n\n        name = f"hf_{saved:05d}"\n        img.save(out_images / f"{name}.jpg", quality=95)\n        (out_labels / f"{name}.txt").write_text(label, encoding="utf-8")\n        saved += 1\n    log.info("Đã lưu %d ảnh (bỏ qua %d mẫu)", saved, skipped)\n    return saved', 'metadata': {'file_path': 'dataset/hf_loader.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'download_from_hf', 'parent_class': '', 'start_line': 40, 'end_line': 78, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'cc86106f-3151-59d0-9c74-2e1f1e516333', 'content': '# File: dataset/hf_loader.py\n# Node: hf_loader\n"""Đọc dataset từ Hugging Face -> ghi ảnh + nhãn YOLO-seg vào data/raw/."""\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom utils import get_logger\n\nfrom .converter import polygon_to_yolo_seg\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'dataset/hf_loader.py', 'directory_path': 'dataset', 'chunk_type': 'module_header', 'node_name': 'hf_loader', 'parent_class': '', 'start_line': 1, 'end_line': 10, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '4dd94ee8-69b5-5c46-9762-7b8f395fcccb', 'content': '# File: dataset/splitter.py\n# Node: split_dataset\ndef split_dataset(raw_images, raw_labels, out_dir, classes, extensions,\n                  val_ratio=0.15, test_ratio=0.05, seed=42) -> Path:\n    raw_labels, out_dir = Path(raw_labels), Path(out_dir)\n    pairs = [(img, raw_labels / f"{img.stem}.txt") for img in list_images(raw_images, extensions)]\n    pairs = [(i, l) for i, l in pairs if l.exists()]\n    if not pairs:\n        raise RuntimeError("Không tìm thấy cặp ảnh/nhãn nào.")\n\n    random.Random(seed).shuffle(pairs)\n    n = len(pairs)\n    n_test, n_val = int(n * test_ratio), int(n * val_ratio)\n    splits = {"test": pairs[:n_test],\n              "val": pairs[n_test:n_test + n_val],\n              "train": pairs[n_test + n_val:]}\n\n    for name, items in splits.items():\n        (out_dir / "images" / name).mkdir(parents=True, exist_ok=True)\n        (out_dir / "labels" / name).mkdir(parents=True, exist_ok=True)\n        for img, lbl in items:\n            shutil.copy2(img, out_dir / "images" / name / img.name)\n            shutil.copy2(lbl, out_dir / "labels" / name / lbl.name)\n        log.info("Split %-5s: %d ảnh", name, len(items))\n\n    data_yaml = out_dir / "dataset.yaml"\n    data_yaml.write_text(yaml.safe_dump({\n        "path": str(out_dir.resolve()),\n        "train": "images/train", "val": "images/val", "test": "images/test",\n        "names": {i: c for i, c in enumerate(classes)},\n    }, allow_unicode=True), encoding="utf-8")\n    log.info("Đã ghi %s", data_yaml)\n    return data_yaml', 'metadata': {'file_path': 'dataset/splitter.py', 'directory_path': 'dataset', 'chunk_type': 'function', 'node_name': 'split_dataset', 'parent_class': '', 'start_line': 13, 'end_line': 43, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '58d97b1d-f82b-5094-ae10-a03a079f6df2', 'content': '# File: dataset/splitter.py\n# Node: splitter\n"""Chia ảnh + nhãn thành train/val/test theo cấu trúc YOLO và sinh dataset.yaml."""\nimport random\nimport shutil\nfrom pathlib import Path\n\nimport yaml\n\nfrom utils import get_logger, list_images\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'dataset/splitter.py', 'directory_path': 'dataset', 'chunk_type': 'module_header', 'node_name': 'splitter', 'parent_class': '', 'start_line': 1, 'end_line': 10, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '143aa764-caa8-5a69-bae6-845c7e97b8db', 'content': '# File: models/__init__.py\n# Node: __init__\nfrom .detector import DocumentDetector\n\n__all__ = ["DocumentDetector"]\n', 'metadata': {'file_path': 'models/__init__.py', 'directory_path': 'models', 'chunk_type': 'entire_file', 'node_name': '__init__', 'parent_class': '', 'start_line': 1, 'end_line': 3, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '0a8c824a-d7a3-5937-8cdf-2eedd97fbcef', 'content': '# File: models/detector.py\n# Node: DocumentDetector\nclass DocumentDetector:\n    """Bọc YOLO-seg: trả về đa giác (N,2) của tài liệu, toạ độ theo ảnh gốc."""\n\n    def __init__(self, weights: str, conf=0.5, iou=0.7, imgsz=640, device=0):\n        self.model = YOLO(weights)\n        self.kw = dict(conf=conf, iou=iou, imgsz=imgsz, device=device, verbose=False)\n\n    def detect(self, image: np.ndarray) -> np.ndarray | None:\n        res = self.model.predict(image, **self.kw)[0]\n        if res.masks is None or len(res.masks) == 0:\n            log.warning("Không phát hiện tài liệu")\n            return None\n        best = int(res.boxes.conf.argmax())\n        return res.masks.xy[best]', 'metadata': {'file_path': 'models/detector.py', 'directory_path': 'models', 'chunk_type': 'class', 'node_name': 'DocumentDetector', 'parent_class': '', 'start_line': 9, 'end_line': 22, 'language': 'py', 'docstring': 'Bọc YOLO-seg: trả về đa giác (N,2) của tài liệu, toạ độ theo ảnh gốc.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '8911223c-dc38-5e25-bbe4-30b4b24e5bc0', 'content': '# File: models/detector.py\n# Node: detector\nimport numpy as np\nfrom ultralytics import YOLO\n\nfrom utils import get_logger\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'models/detector.py', 'directory_path': 'models', 'chunk_type': 'module_header', 'node_name': 'detector', 'parent_class': '', 'start_line': 1, 'end_line': 6, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '1a8efd89-e922-5c75-b56d-70c6b68a21c5', 'content': '# File: models/trainer.py\n# Node: train\ndef train(settings: dict):\n    cfg, paths = settings["train"], settings["paths"]\n    log.info("Bắt đầu train: model=%s epochs=%s imgsz=%s", cfg["model"], cfg["epochs"], cfg["imgsz"])\n    model = YOLO(cfg["model"])\n    results = model.train(\n        data=str(resolve(paths["dataset_yaml"])),\n        epochs=cfg["epochs"], imgsz=cfg["imgsz"], batch=cfg["batch"],\n        device=cfg["device"], workers=cfg["workers"], patience=cfg["patience"],\n        seed=cfg["seed"], project=str(resolve(paths["runs_dir"])), name=cfg["run_name"],\n        **cfg.get("augment", {}),\n    )\n    log.info("Train xong. Kết quả lưu ở %s", results.save_dir)\n    return results', 'metadata': {'file_path': 'models/trainer.py', 'directory_path': 'models', 'chunk_type': 'function', 'node_name': 'train', 'parent_class': '', 'start_line': 9, 'end_line': 21, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '793c7248-402f-55ce-a1eb-bb78a527777b', 'content': '# File: models/trainer.py\n# Node: validate\ndef validate(weights: str, settings: dict):\n    model = YOLO(weights)\n    metrics = model.val(data=str(resolve(settings["paths"]["dataset_yaml"])),\n                        split="test", imgsz=settings["train"]["imgsz"])\n    log.info("mAP50-95 (mask) = %.4f", metrics.seg.map)\n    return metrics', 'metadata': {'file_path': 'models/trainer.py', 'directory_path': 'models', 'chunk_type': 'function', 'node_name': 'validate', 'parent_class': '', 'start_line': 24, 'end_line': 29, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'f78186a4-1e1f-5f2a-9f90-f2e11d5ec8d6', 'content': '# File: models/trainer.py\n# Node: trainer\nfrom ultralytics import YOLO\n\nfrom config import resolve\nfrom utils import get_logger\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'models/trainer.py', 'directory_path': 'models', 'chunk_type': 'module_header', 'node_name': 'trainer', 'parent_class': '', 'start_line': 1, 'end_line': 6, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '6699658f-48d5-5b92-8ade-2bdb1ac10925', 'content': '# File: processing/__init__.py\n# Node: __init__\nfrom .enhance import scan_effect\nfrom .geometry import four_point_transform, order_points, polygon_to_quad\nfrom .scanner import DocumentScanner\n\n__all__ = ["DocumentScanner", "four_point_transform", "order_points",\n           "polygon_to_quad", "scan_effect"]\n', 'metadata': {'file_path': 'processing/__init__.py', 'directory_path': 'processing', 'chunk_type': 'entire_file', 'node_name': '__init__', 'parent_class': '', 'start_line': 1, 'end_line': 6, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '3465abb7-feb7-527e-8773-95df7378485d', 'content': '# File: processing/enhance.py\n# Node: scan_effect\ndef scan_effect(image: np.ndarray) -> np.ndarray:\n    """Làm sạch nền, tăng tương phản kiểu máy scan."""\n    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n    return cv2.adaptiveThreshold(gray, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n                                 cv2.THRESH_BINARY, 21, 10)', 'metadata': {'file_path': 'processing/enhance.py', 'directory_path': 'processing', 'chunk_type': 'function', 'node_name': 'scan_effect', 'parent_class': '', 'start_line': 5, 'end_line': 9, 'language': 'py', 'docstring': 'Làm sạch nền, tăng tương phản kiểu máy scan.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '7a5ba316-0e20-5140-8200-924fb7420e65', 'content': '# File: processing/enhance.py\n# Node: enhance\nimport cv2\nimport numpy as np', 'metadata': {'file_path': 'processing/enhance.py', 'directory_path': 'processing', 'chunk_type': 'module_header', 'node_name': 'enhance', 'parent_class': '', 'start_line': 1, 'end_line': 2, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '04226044-0c19-5aad-996a-c039f06037d6', 'content': '# File: processing/geometry.py\n# Node: order_points\ndef order_points(pts) -> np.ndarray:\n    """Sắp xếp 4 điểm: trên-trái, trên-phải, dưới-phải, dưới-trái."""\n    pts = np.asarray(pts, dtype="float32").reshape(4, 2)\n    s, d = pts.sum(axis=1), np.diff(pts, axis=1).ravel()\n    return np.array([pts[np.argmin(s)], pts[np.argmin(d)],\n                     pts[np.argmax(s)], pts[np.argmax(d)]], dtype="float32")', 'metadata': {'file_path': 'processing/geometry.py', 'directory_path': 'processing', 'chunk_type': 'function', 'node_name': 'order_points', 'parent_class': '', 'start_line': 5, 'end_line': 10, 'language': 'py', 'docstring': 'Sắp xếp 4 điểm: trên-trái, trên-phải, dưới-phải, dưới-trái.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '004d0eb9-47ba-59a5-9b4a-84d767b304d2', 'content': '# File: processing/geometry.py\n# Node: polygon_to_quad\ndef polygon_to_quad(polygon) -> np.ndarray:\n    """Xấp xỉ đa giác mask thành tứ giác 4 góc."""\n    hull = cv2.convexHull(np.asarray(polygon, dtype="float32"))\n    peri = cv2.arcLength(hull, True)\n    for eps in np.linspace(0.01, 0.1, 10):\n        approx = cv2.approxPolyDP(hull, eps * peri, True)\n        if len(approx) == 4:\n            return order_points(approx)\n    return order_points(cv2.boxPoints(cv2.minAreaRect(hull)))', 'metadata': {'file_path': 'processing/geometry.py', 'directory_path': 'processing', 'chunk_type': 'function', 'node_name': 'polygon_to_quad', 'parent_class': '', 'start_line': 13, 'end_line': 21, 'language': 'py', 'docstring': 'Xấp xỉ đa giác mask thành tứ giác 4 góc.', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '66524c8b-d61c-5dd6-a219-aff8468e3921', 'content': '# File: processing/geometry.py\n# Node: four_point_transform\ndef four_point_transform(image: np.ndarray, quad) -> np.ndarray:\n    tl, tr, br, bl = order_points(quad)\n    w = int(max(np.linalg.norm(br - bl), np.linalg.norm(tr - tl)))\n    h = int(max(np.linalg.norm(tr - br), np.linalg.norm(tl - bl)))\n    dst = np.array([[0, 0], [w - 1, 0], [w - 1, h - 1], [0, h - 1]], dtype="float32")\n    M = cv2.getPerspectiveTransform(np.array([tl, tr, br, bl], dtype="float32"), dst)\n    return cv2.warpPerspective(image, M, (w, h))', 'metadata': {'file_path': 'processing/geometry.py', 'directory_path': 'processing', 'chunk_type': 'function', 'node_name': 'four_point_transform', 'parent_class': '', 'start_line': 24, 'end_line': 30, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'eff0db9b-d829-54f0-b916-63f89c30e3f5', 'content': '# File: processing/geometry.py\n# Node: geometry\nimport cv2\nimport numpy as np', 'metadata': {'file_path': 'processing/geometry.py', 'directory_path': 'processing', 'chunk_type': 'module_header', 'node_name': 'geometry', 'parent_class': '', 'start_line': 1, 'end_line': 2, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '81e9acdc-4732-5ee9-b58c-1c33ba37c5ab', 'content': '# File: processing/scanner.py\n# Node: DocumentScanner\nclass DocumentScanner:\n    def __init__(self, detector: DocumentDetector, enhance: bool = True):\n        self.detector, self.enhance = detector, enhance\n\n    def scan(self, image: np.ndarray) -> np.ndarray | None:\n        polygon = self.detector.detect(image)\n        if polygon is None:\n            return None\n        quad = polygon_to_quad(polygon)\n        warped = four_point_transform(image, quad)\n        return scan_effect(warped) if self.enhance else warped', 'metadata': {'file_path': 'processing/scanner.py', 'directory_path': 'processing', 'chunk_type': 'class', 'node_name': 'DocumentScanner', 'parent_class': '', 'start_line': 12, 'end_line': 22, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'a9fb48c2-eb7f-588c-bf00-cb5dac7b1d17', 'content': '# File: processing/scanner.py\n# Node: scanner\nimport numpy as np\n\nfrom models import DocumentDetector\nfrom utils import get_logger\n\nfrom .enhance import scan_effect\nfrom .geometry import four_point_transform, polygon_to_quad\n\nlog = get_logger(__name__)', 'metadata': {'file_path': 'processing/scanner.py', 'directory_path': 'processing', 'chunk_type': 'module_header', 'node_name': 'scanner', 'parent_class': '', 'start_line': 1, 'end_line': 9, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '88347e80-f18e-5a9b-a7c4-7abd2987ece8', 'content': '# File: scripts/download_hf_dataset.py\n# Node: main\ndef main():\n    setup_logging()\n    ap = argparse.ArgumentParser()\n    ap.add_argument("--inspect", action="store_true", help="chỉ in cấu trúc cột")\n    args = ap.parse_args()\n\n    s = load_settings()\n    hf, p = s["huggingface"], s["paths"]\n    if args.inspect:\n        inspect_hf_dataset(hf["repo_id"], hf["split"])\n        return\n    download_from_hf(\n        hf["repo_id"], hf.get("split", "train"), hf.get("max_samples", 2000),\n        hf.get("image_column", "image"), hf["corners_column"],\n        hf.get("normalized", "auto"),\n        resolve(p["raw_images"]), resolve(p["raw_labels"]), hf.get("streaming", True),\n        negative_column=hf.get("negative_column"),\n        keep_negatives=hf.get("keep_negatives", True),\n    )', 'metadata': {'file_path': 'scripts/download_hf_dataset.py', 'directory_path': 'scripts', 'chunk_type': 'function', 'node_name': 'main', 'parent_class': '', 'start_line': 11, 'end_line': 29, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '1a3f0727-b590-5596-b17e-31b3d6aa342e', 'content': '# File: scripts/download_hf_dataset.py\n# Node: download_hf_dataset\n"""\npython -m scripts.download_hf_dataset --inspect   # xem tên cột trước\npython -m scripts.download_hf_dataset             # tải + chuyển sang YOLO-seg\n"""\nimport argparse\n\nfrom config import load_settings, resolve, setup_logging\nfrom dataset import download_from_hf, inspect_hf_dataset\n\nif __name__ == "__main__":\n    main()', 'metadata': {'file_path': 'scripts/download_hf_dataset.py', 'directory_path': 'scripts', 'chunk_type': 'module_header', 'node_name': 'download_hf_dataset', 'parent_class': '', 'start_line': 1, 'end_line': 33, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '7a7ce9b2-0f0f-585e-8467-ebc7f0db5b59', 'content': '# File: scripts/predict.py\n# Node: main\ndef main():\n    setup_logging()\n    log = get_logger("predict")\n    ap = argparse.ArgumentParser()\n    ap.add_argument("--source", required=True)\n    args = ap.parse_args()\n\n    s = load_settings()\n    inf = s["inference"]\n    detector = DocumentDetector(str(resolve(inf["weights"])), inf["conf"], inf["iou"],\n                                inf["imgsz"], inf["device"])\n    scanner = DocumentScanner(detector, inf["enhance"])\n\n    result = scanner.scan(read_image(args.source))\n    if result is None:\n        log.error("Không quét được: %s", args.source)\n        return\n    out = resolve(s["paths"]["output_dir"]) / f"{Path(args.source).stem}_scanned.png"\n    save_image(out, result)\n    log.info("Đã lưu %s", out)', 'metadata': {'file_path': 'scripts/predict.py', 'directory_path': 'scripts', 'chunk_type': 'function', 'node_name': 'main', 'parent_class': '', 'start_line': 11, 'end_line': 30, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': 'f14f378b-c812-5108-b655-5f40d26c514b', 'content': '# File: scripts/predict.py\n# Node: predict\n"""python -m scripts.predict --source anh_chup.jpg"""\nimport argparse\nfrom pathlib import Path\n\nfrom config import load_settings, resolve, setup_logging\nfrom models import DocumentDetector\nfrom processing import DocumentScanner\nfrom utils import get_logger, read_image, save_image\n\nif __name__ == "__main__":\n    main()', 'metadata': {'file_path': 'scripts/predict.py', 'directory_path': 'scripts', 'chunk_type': 'module_header', 'node_name': 'predict', 'parent_class': '', 'start_line': 1, 'end_line': 34, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '4b245503-e8b5-5496-a05d-6de3e28ff7db', 'content': '# File: scripts/prepare_dataset.py\n# Node: main\ndef main():\n    setup_logging()\n    s = load_settings()\n    d, p = s["dataset"], s["paths"]\n    split_dataset(resolve(p["raw_images"]), resolve(p["raw_labels"]), resolve(p["processed_dir"]),\n                  d["classes"], d["image_extensions"], d["val_ratio"], d["test_ratio"], d["seed"])', 'metadata': {'file_path': 'scripts/prepare_dataset.py', 'directory_path': 'scripts', 'chunk_type': 'function', 'node_name': 'main', 'parent_class': '', 'start_line': 6, 'end_line': 11, 'language': 'py', 'docstring': '', 'has_syntax_error': False, 'syntax_errors': []}}, {'id': '051f10e6-fdcf-5965-9678-3d47a71833aa', 'content': '# File: scripts/prepare_dataset.py\n# Node: prepare_dataset\n"""python -m scripts.prepare_dataset"""\nfrom config import load_settings, resolve, setup_logging\nfrom dataset import split_dataset\n\nif __name__ == "__main__":\n    main()', 'metadata': {'file_path': 'scripts/prepare_dataset.py', 'directo